@model WebApplication1.Models.ChallengeDetailsViewModel
@using WebApplication1.Models

@{
    ViewData["Title"] = Model.Challenge.Title;
    var challenge = Model.Challenge;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    string DifficultyLabel(string value) => value switch
    {
        ChallengeDifficulties.Easy => "Легко",
        ChallengeDifficulties.Normal => "Нормально",
        ChallengeDifficulties.Hard => "Сложно",
        ChallengeDifficulties.Legendary => "Легендарно",
        _ => value
    };

    string CategoryLabel(string value) => value switch
    {
        ChallengeCategories.Completion => "Закрытие",
        ChallengeCategories.Speedrun => "Спидран",
        ChallengeCategories.Collection => "Коллекция",
        ChallengeCategories.RareHunt => "Редкости",
        ChallengeCategories.Skill => "Скилл",
        ChallengeCategories.Coop => "Кооператив",
        ChallengeCategories.Hardcore => "Хардкор",
        ChallengeCategories.Discovery => "Исследование",
        ChallengeCategories.Creative => "Креатив",
        ChallengeCategories.Community => "Сообщество",
        _ => value
    };

    string TypeLabel(string value) => value switch
    {
        ChallengeTypes.Completion => "100% игры",
        ChallengeTypes.AchievementHunt => "Охота за достижениями",
        ChallengeTypes.RareAchievementHunt => "Редкие достижения",
        ChallengeTypes.TimeTrial => "На время",
        ChallengeTypes.Marathon => "Марафон",
        ChallengeTypes.NoDeath => "Без смертей",
        ChallengeTypes.TeamRun => "Командный забег",
        ChallengeTypes.CreativeProof => "Креативное доказательство",
        _ => value
    };

    string VerificationLabel()
    {
        if (challenge.VerificationType == ChallengeVerificationTypes.Manual)
            return "Ручная проверка";

        return challenge.AutoGoalType switch
        {
            ChallengeAutoGoalTypes.EarnAchievementsInGame => $"Авто: {challenge.TargetValue} достиж.",
            ChallengeAutoGoalTypes.EarnRareAchievementsInGame => $"Авто: {challenge.TargetValue} редк.",
            _ => "Авто: 100% игры"
        };
    }

    string TimeSpentLabel(TimeSpan? value)
    {
        if (!value.HasValue)
            return "В процессе";

        var span = value.Value;
        if (span.TotalDays >= 1)
            return $"{(int)span.TotalDays} д {span.Hours} ч";

        if (span.TotalHours >= 1)
            return $"{(int)span.TotalHours} ч {span.Minutes} мин";

        return $"{Math.Max(1, span.Minutes)} мин";
    }
}

<main class="challenge-details-page">
    <section class="challenge-details-hero">
        <div class="challenge-details-cover">
            @if (!string.IsNullOrWhiteSpace(challenge.CoverImageUrl))
            {
                <img src="@challenge.CoverImageUrl" alt="@challenge.Title" />
            }
            else
            {
                <div>@CategoryLabel(challenge.Category)</div>
            }
        </div>

        <div class="challenge-details-content">
            <a class="challenge-back-link" asp-controller="Challenges" asp-action="Index">← Все челленджи</a>
            <h1>@challenge.Title</h1>
            <p>@challenge.Description</p>

            <div class="challenge-tags">
                <span>@CategoryLabel(challenge.Category)</span>
                <span>@TypeLabel(challenge.ChallengeType)</span>
                <span>@VerificationLabel()</span>
                <span>@DifficultyLabel(challenge.Difficulty)</span>
                @if (!string.IsNullOrWhiteSpace(challenge.GameName))
                {
                    <span>@challenge.GameName</span>
                }
            </div>

            <div class="challenge-details-stats">
                <div><span>Награда</span><strong>@challenge.RewardExperience XP</strong></div>
                <div><span>Участники</span><strong>@challenge.ParticipantsCount / @challenge.ParticipantLimit</strong></div>
                <div><span>Выполнено</span><strong>@challenge.CompletedCount</strong></div>
                <div><span>Автор</span><strong>@challenge.CreatedByName</strong></div>
            </div>

            <div class="challenge-actions details-actions">
                @if (challenge.UserCanJoin)
                {
                    <form asp-controller="Challenges" asp-action="Join" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@challenge.Id" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="challenge-btn primary">Участвовать</button>
                    </form>
                }
                else if (challenge.UserCompleted)
                {
                    <span class="challenge-state completed">Выполнено</span>
                }
                else if (challenge.UserParticipantStatus == ChallengeParticipantStatuses.Joined && challenge.VerificationType == ChallengeVerificationTypes.Automatic)
                {
                    <form asp-controller="Challenges" asp-action="Check" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@challenge.Id" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="challenge-btn primary">Проверить системой</button>
                    </form>
                }
                else if (challenge.UserParticipantStatus == ChallengeParticipantStatuses.Joined)
                {
                    <span class="challenge-state">Участвуешь</span>
                }

                @if (!Model.IsSignedIn)
                {
                    <a class="challenge-btn primary" asp-controller="Account" asp-action="Login">Войти через Steam</a>
                }
            </div>
        </div>
    </section>

    @if (TempData["ChallengesSuccess"] is string successMessage)
    {
        <div class="challenge-flash success">@successMessage</div>
    }

    @if (TempData["ChallengesError"] is string errorMessage)
    {
        <div class="challenge-flash error">@errorMessage</div>
    }

    <section class="challenge-details-grid">
        <div class="challenge-detail-panel">
            <div class="challenge-section-head">
                <div>
                    <span class="section-kicker">Участники</span>
                    <h2>Время прохождения</h2>
                </div>
            </div>

            @if (!Model.Participants.Any())
            {
                <div class="challenge-empty">Пока никто не участвует.</div>
            }
            else
            {
                <div class="challenge-participants-list">
                    @foreach (var participant in Model.Participants)
                    {
                        <a class="challenge-participant-row" asp-controller="Profile" asp-action="UserProfile" asp-route-steamId="@participant.SteamId">
                            <img src="@participant.AvatarUrl" alt="@participant.UserName" loading="lazy" />
                            <div>
                                <strong>@participant.UserName</strong>
                                <span>@(participant.Status == ChallengeParticipantStatuses.Completed ? "Выполнено" : "В процессе")</span>
                            </div>
                            <time>@TimeSpentLabel(participant.TimeSpent)</time>
                        </a>
                    }
                </div>
            }
        </div>

        <aside class="challenge-detail-panel">
            <div class="challenge-section-head compact">
                <div>
                    <span class="section-kicker">Проверка</span>
                    <h2>Доказательства</h2>
                </div>
            </div>

            @if (challenge.VerificationType == ChallengeVerificationTypes.Manual && !string.IsNullOrWhiteSpace(challenge.ManualProofDescription))
            {
                @if (!challenge.UserHasPendingSubmission){
                <div class="challenge-proof-rule">@challenge.ManualProofDescription</div>
                }
            }

            @if (challenge.UserCanSubmitProof)
            {
                <form asp-controller="Challenges" asp-action="SubmitProof" method="post" class="challenge-proof-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@challenge.Id" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input type="url" name="proofUrl" placeholder="Ссылка на видео, скриншот или профиль" maxlength="2048" required />
                    <textarea name="comment" placeholder="Комментарий создателю" maxlength="1000"></textarea>
                    <button type="submit" class="challenge-btn primary">Отправить</button>
                </form>
            }
            else if (challenge.UserHasPendingSubmission)
            {
                <div class="challenge-empty">Твое доказательство ожидает проверки.</div>
            }

            @if (challenge.PendingSubmissions.Any())
            {
                <div class="creator-review-box">
                    <h3>Заявки на подтверждение</h3>
                    @foreach (var submission in challenge.PendingSubmissions)
                    {
                        <div class="creator-submission">
                            <div>
                                <strong>@submission.UserName</strong>
                                <a href="@submission.ProofUrl" target="_blank" rel="noopener noreferrer">@submission.ProofUrl</a>
                                @if (!string.IsNullOrWhiteSpace(submission.Comment))
                                {
                                    <p>@submission.Comment</p>
                                }
                            </div>
                            <div class="creator-submission-actions">
                                <form asp-controller="Challenges" asp-action="ApproveSubmission" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@submission.Id" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="challenge-btn primary">Подтвердить</button>
                                </form>
                                <form asp-controller="Challenges" asp-action="RejectSubmission" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@submission.Id" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="challenge-btn danger">Отклонить</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </aside>
    </section>
</main>