@model WebApplication1.Models.User
@using System.Globalization
@{
    ViewData["Title"] = $"{Model.SteamName} - Профиль";
    var isOwner = ViewBag.IsOwner == true;
    string avatarUrl = ViewBag.ProfileAvatarUrl as string ?? "";

    if (string.IsNullOrWhiteSpace(avatarUrl) && !string.IsNullOrWhiteSpace(Model.AvatarID))
    {
        if (Model.AvatarID.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            avatarUrl = Model.AvatarID;
        }
        else if (Model.AvatarID.Length >= 2)
        {
            avatarUrl = $"https://steamcdn-a.akamaihd.net/steamcommunity/public/images/avatars/{Model.AvatarID.Substring(0, 2)}/{Model.AvatarID}_full.jpg";
        }
        else
        {
            avatarUrl = "/images/default_avatar.png";
        }
    }
    else if (string.IsNullOrWhiteSpace(avatarUrl))
    {
        avatarUrl = "/images/default_avatar.png";
    }

    var recentAchievements = (IEnumerable<WebApplication1.Models.AchievementCardViewModel>)ViewBag.RecentAchievements;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 24);
    var currentRarityFilter = (string)(ViewBag.CurrentRarityFilter ?? "all");
    var timelineSeries = (ViewBag.AchievementTimeline as WebApplication1.Models.AchievementTimelineViewModel)?.Series
        ?? new List<WebApplication1.Models.AchievementTimelineSeriesViewModel>();
    var levelInfo = ViewBag.LevelInfo as WebApplication1.Models.AchievementLevelInfo;
    var levelProgress = levelInfo?.ProgressPercent.ToString("0.##", CultureInfo.InvariantCulture) ?? "0";
    var steamProfileUrl = string.IsNullOrWhiteSpace(Model.SteamId)
        ? ""
        : $"https://steamcommunity.com/profiles/{Uri.EscapeDataString(Model.SteamId)}";
}

<section class="profile-page">
    <div class="profile-card">
        <div class="profile-main">
            <img src="@avatarUrl" class="profile-avatar" />

            <div class="profile-content">
                <div class="profile-top">
                    <div>
                        <h1 class="profile-name">@Model.SteamName</h1>
                        @if (TempData["ProfileSyncSuccess"] is string syncMessage)
                        {
                            <div class="profile-sync-status">@syncMessage</div>
                        }
                        @if (TempData["ProfileSyncError"] is string syncError)
                        {
                            <div class="profile-sync-status error">@syncError</div>
                        }
                    </div>

                    @if (isOwner || !string.IsNullOrWhiteSpace(steamProfileUrl))
                    {
                        <div class="profile-actions">
                            @if (!string.IsNullOrWhiteSpace(steamProfileUrl))
                            {
                                <a class="profile-sync-btn profile-steam-link"
                                   href="@steamProfileUrl"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Steam
                                </a>
                            }

                            @if (isOwner)
                            {
                            <form asp-action="TogglePrivacy" method="post">
                                @Html.AntiForgeryToken()
                                <button class="profile-sync-btn" type="submit">
                                    @(Model.IsProfilePublic ? "Сделать приватным" : "Сделать публичным")
                                </button>
                            </form>

                            <form asp-action="Sync" method="post">
                                @Html.AntiForgeryToken()
                                <button class="profile-sync-btn" type="submit">Синхронизировать ачивки</button>
                            </form>

                            <div id="profile-auto-sync"
                                 data-url="@Url.Action("AutoSync", "Profile")"
                                 data-total="@((int)(ViewBag.TotalAchievements ?? 0))"
                                 hidden></div>
                            }
                        </div>
                    }
                </div>

                <div class="profile-stats">
                    <div class="profile-stat"><div class="profile-stat-value">#@ViewBag.Rank</div><div class="profile-stat-label">Место</div></div>
                    <div class="profile-stat"><div class="profile-stat-value" id="profile-total-achievements">@ViewBag.TotalAchievements</div><div class="profile-stat-label">Ачивок</div></div>
                    <div class="profile-stat"><div class="profile-stat-value">@ViewBag.GamesCount</div><div class="profile-stat-label">Игр</div></div>
                    <div class="profile-stat"><div class="profile-stat-value">LVL @ViewBag.ProfileLevel</div><div class="profile-stat-label">@ViewBag.ProfileXp XP</div></div>
                </div>

                @if (levelInfo != null)
                {
                    <div class="profile-level">
                        <div class="profile-level-head">
                            <span>Уровень @levelInfo.Level</span>
                            <span>@levelInfo.CurrentLevelXp / @levelInfo.RequiredXp XP</span>
                        </div>
                        <div class="profile-level-bar" aria-label="Прогресс уровня">
                            <div class="profile-level-fill" style="width:@levelProgress%"></div>
                        </div>
                        <div class="profile-level-next">До следующего уровня: @levelInfo.RemainingXp XP</div>
                        <div class="profile-level-next">Ачивки: @ViewBag.AchievementXp XP · квесты и челленджи: @ViewBag.QuestXp XP</div>
                    </div>
                }

                <div class="rarity-summary">
                    <div class="rarity-chip legendary">Легендарные: @ViewBag.LegendaryCount</div>
                    <div class="rarity-chip epic">Эпические: @ViewBag.EpicCount</div>
                    <div class="rarity-chip rare">Редкие: @ViewBag.RareCount</div>
                    <div class="rarity-chip common">Обычные: @ViewBag.CommonCount</div>
                </div>
            </div>
        </div>
    </div>

    @if (timelineSeries.Any())
    {
        <section class="achievement-timeline-panel" aria-labelledby="achievement-timeline-title">
            <div class="achievement-timeline-head">
                <div>
                    <h2 id="achievement-timeline-title">Статистика получения ачивок</h2>
                    <p>Динамика по датам получения достижений.</p>
                </div>

                <div class="achievement-timeline-tabs" role="tablist" aria-label="Период статистики">
                    @for (var i = 0; i < timelineSeries.Count; i++)
                    {
                        var series = timelineSeries[i];
                        <button class="achievement-timeline-tab @(i == 0 ? "active" : "")"
                                type="button"
                                role="tab"
                                aria-selected="@(i == 0 ? "true" : "false")"
                                aria-controls="achievement-timeline-@series.Key"
                                data-timeline-tab="@series.Key">
                            @series.Label
                        </button>
                    }
                </div>
            </div>

            @for (var i = 0; i < timelineSeries.Count; i++)
            {
                var series = timelineSeries[i];
                var graphWidth = 960d;
                var graphHeight = 300d;
                var graphLeft = 54d;
                var graphRight = 24d;
                var graphTop = 24d;
                var graphBottom = 238d;
                var plotWidth = graphWidth - graphLeft - graphRight;
                var plotHeight = graphBottom - graphTop;
                var graphPoints = series.Points
                    .Select((point, index) => new
                    {
                        Point = point,
                        Index = index,
                        X = graphLeft + (series.Points.Count <= 1 ? plotWidth / 2 : plotWidth * index / (series.Points.Count - 1)),
                        Y = graphBottom - point.Percent * plotHeight / 100d
                    })
                    .ToList();
                var linePath = graphPoints.Any()
                    ? string.Join(" ", graphPoints.Select((point, index) =>
                        $"{(index == 0 ? "M" : "L")} {point.X.ToString("0.##", CultureInfo.InvariantCulture)} {point.Y.ToString("0.##", CultureInfo.InvariantCulture)}"))
                    : "";
                var areaPath = graphPoints.Any()
                    ? $"M {graphPoints.First().X.ToString("0.##", CultureInfo.InvariantCulture)} {graphBottom.ToString("0.##", CultureInfo.InvariantCulture)} " +
                      string.Join(" ", graphPoints.Select(point =>
                          $"L {point.X.ToString("0.##", CultureInfo.InvariantCulture)} {point.Y.ToString("0.##", CultureInfo.InvariantCulture)}")) +
                      $" L {graphPoints.Last().X.ToString("0.##", CultureInfo.InvariantCulture)} {graphBottom.ToString("0.##", CultureInfo.InvariantCulture)} Z"
                    : "";

                <div id="achievement-timeline-@series.Key"
                     class="achievement-timeline-chart @(i == 0 ? "active" : "")"
                     role="tabpanel"
                     data-timeline-chart="@series.Key">
                    <div class="achievement-timeline-meta">
                        <span>@series.Description</span>
                        <strong>@series.Total</strong>
                    </div>

                    <div class="achievement-graph-scroll">
                        <svg class="achievement-graph"
                             viewBox="0 0 @graphWidth.ToString("0", CultureInfo.InvariantCulture) @graphHeight.ToString("0", CultureInfo.InvariantCulture)"
                             role="img"
                             aria-label="@($"{series.Label}: {series.Total} ачивок")">
                            <defs>
                                <linearGradient id="achievement-line-gradient-@series.Key" x1="0" y1="0" x2="1" y2="0">
                                    <stop offset="0%" stop-color="#34d399" />
                                    <stop offset="50%" stop-color="#d4af37" />
                                    <stop offset="100%" stop-color="#f5d77b" />
                                </linearGradient>
                                <linearGradient id="achievement-area-gradient-@series.Key" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#d4af37" stop-opacity="0.28" />
                                    <stop offset="100%" stop-color="#34d399" stop-opacity="0.03" />
                                </linearGradient>
                            </defs>

                            @for (var grid = 0; grid <= 4; grid++)
                            {
                                var y = graphBottom - plotHeight * grid / 4d;
                                var value = series.MaxCount == 0 ? 0 : (int)Math.Round(series.MaxCount * grid / 4d);
                                <line class="achievement-graph-grid"
                                      x1="@graphLeft.ToString("0.##", CultureInfo.InvariantCulture)"
                                      y1="@y.ToString("0.##", CultureInfo.InvariantCulture)"
                                      x2="@((graphWidth - graphRight).ToString("0.##", CultureInfo.InvariantCulture))"
                                      y2="@y.ToString("0.##", CultureInfo.InvariantCulture)" />
                                @Html.Raw($"<text class=\"achievement-graph-axis\" x=\"14\" y=\"{(y + 4).ToString("0.##", CultureInfo.InvariantCulture)}\">{value}</text>")
                            }

                            @if (graphPoints.Any())
                            {
                                <path class="achievement-graph-area" d="@areaPath" />
                                <path class="achievement-graph-line" d="@linePath" pathLength="1" />

                                @foreach (var point in graphPoints)
                                {
                                    var pointDelay = $"{(220 + point.Index * 36).ToString(CultureInfo.InvariantCulture)}ms";
                                    var labelClass = series.Points.Count > 12 && point.Index % 3 != 0
                                        ? "achievement-graph-label compact-hidden"
                                        : "achievement-graph-label";

                                    <g class="achievement-graph-point"
                                       style="--point-delay:@pointDelay"
                                       tabindex="0">
                                        <title>@($"{point.Point.Label}: {point.Point.Count}")</title>
                                        <circle cx="@point.X.ToString("0.##", CultureInfo.InvariantCulture)"
                                                cy="@point.Y.ToString("0.##", CultureInfo.InvariantCulture)"
                                                r="5" />
                                    </g>

                                    @Html.Raw($"<text class=\"{labelClass}\" x=\"{point.X.ToString("0.##", CultureInfo.InvariantCulture)}\" y=\"276\">{System.Net.WebUtility.HtmlEncode(point.Point.ShortLabel)}</text>")
                                }
                            }
                        </svg>
                    </div>
                </div>
            }
        </section>
    }

    <h2 class="profile-section-title">Последние достижения</h2>
    @if (recentAchievements.Any())
    {
        <div class="achievements-grid">
            @foreach (var ua in recentAchievements)
            {
                <partial name="_AchievementCard" model="ua" />
            }
        </div>
    }
    else
    {
        <div class="no-achievements">Пока нет полученных достижений.</div>
    }

    <section id="profile-achievements"
             class="profile-achievements-panel"
             data-achievements-url="@Url.Action("Achievements", "Profile", new { steamId = Model.SteamId })"
             data-page-size="@pageSize"
             data-current-page="@currentPage"
             data-current-rarity="@currentRarityFilter">
        <partial name="_ProfileAchievementsList" />
    </section>
</section>

<script>
    (() => {
        const panel = document.querySelector('.achievement-timeline-panel');
        if (!panel) {
            return;
        }

        const tabs = [...panel.querySelectorAll('[data-timeline-tab]')];
        const charts = [...panel.querySelectorAll('[data-timeline-chart]')];
        const reveal = () => panel.classList.add('is-visible');

        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
                if (entries.some((entry) => entry.isIntersecting)) {
                    reveal();
                    observer.disconnect();
                }
            }, { threshold: 0.2 });

            observer.observe(panel);
        } else {
            reveal();
        }

        tabs.forEach((tab) => {
            tab.addEventListener('click', () => {
                const key = tab.dataset.timelineTab;

                tabs.forEach((item) => {
                    const isActive = item === tab;
                    item.classList.toggle('active', isActive);
                    item.setAttribute('aria-selected', isActive ? 'true' : 'false');
                });

                charts.forEach((chart) => {
                    const isActive = chart.dataset.timelineChart === key;
                    chart.classList.toggle('active', isActive);

                    if (isActive) {
                        chart.classList.remove('is-replaying');
                        void chart.offsetWidth;
                        chart.classList.add('is-replaying');
                    }
                });
            });
        });
    })();
</script>

<script>
    (() => {
        const container = document.getElementById('profile-achievements');
        if (!container || !window.fetch) {
            return;
        }

        const endpoint = container.dataset.achievementsUrl;
        const pageSize = container.dataset.pageSize || '24';
        let loading = false;

        const updateState = () => {
            const state = container.querySelector('[data-achievements-state]');
            if (!state) {
                return;
            }

            container.dataset.currentPage = state.dataset.currentPage || container.dataset.currentPage || '1';
            container.dataset.currentRarity = state.dataset.rarity || container.dataset.currentRarity || 'all';
        };

        const loadAchievements = async (page, rarity) => {
            if (loading || !endpoint) {
                return;
            }

            loading = true;
            container.classList.add('is-loading');

            const url = new URL(endpoint, window.location.origin);
            url.searchParams.set('page', page || container.dataset.currentPage || '1');
            url.searchParams.set('pageSize', pageSize);
            url.searchParams.set('rarity', rarity || container.dataset.currentRarity || 'all');

            try {
                const response = await fetch(url.toString(), {
                    method: 'GET',
                    credentials: 'same-origin',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!response.ok) {
                    window.location.href = url.toString().replace('/Achievements', '/UserProfile');
                    return;
                }

                container.innerHTML = await response.text();
                updateState();
                container.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } catch {
                window.location.reload();
            } finally {
                loading = false;
                container.classList.remove('is-loading');
            }
        };

        updateState();

        container.addEventListener('click', (event) => {
            const link = event.target.closest('[data-achievement-page]');
            if (!link) {
                return;
            }

            event.preventDefault();
            loadAchievements(link.dataset.achievementPage, link.dataset.achievementRarity);
        });
    })();
</script>

@if (isOwner)
{
    <script>
        (() => {
            const marker = document.getElementById('profile-auto-sync');
            if (!marker || !window.fetch) {
                return;
            }

            const tokenInput = document.querySelector('.profile-actions input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';
            const url = marker.dataset.url;
            let knownTotal = Number(marker.dataset.total || '0');
            let syncing = false;

            const syncProfile = async () => {
                if (document.hidden || syncing || !token || !url) {
                    return;
                }

                syncing = true;

                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'RequestVerificationToken': token
                        }
                    });

                    if (!response.ok) {
                        return;
                    }

                    const data = await response.json();
                    const total = Number(data.totalAchievements || knownTotal);

                    if (data.changed || total !== knownTotal) {
                        window.location.reload();
                        return;
                    }

                    knownTotal = total;
                } catch {
                } finally {
                    syncing = false;
                }
            };

            window.setTimeout(syncProfile, 2000);
            window.setInterval(syncProfile, 60000);
        })();
    </script>
}
