@model List<WebApplication1.Models.Game>

@{
    ViewData["Title"] = "Каталог игр";
    var achievementCounts = ViewBag.AchievementCounts as IDictionary<int, int> ?? new Dictionary<int, int>();
    var maxAchievementFilter = Math.Max(0, achievementCounts.Values.DefaultIfEmpty(0).Max());
}


<main class="catalog-page">
    <section class="catalog-hero">
        <div>
            <span class="section-kicker">Каталог</span>
            <h1>Игры</h1>
            <p>Выбирай игру из каталога, смотри достижения и добавляй недостающие проекты из Steam.</p>
        </div>
    </section>

    <nav class="catalog-tabs" aria-label="Действия каталога">
        <a asp-controller="Home"
           asp-action="AchievementVoting"
           class="catalog-tab-link">
            Голосование за новые достижения
        </a>

        @if (User?.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Games" asp-action="AddOwnedLibrary" method="post" class="library-request-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="library-request-btn">Запросить игры из моей библиотеки Steam</button>
            </form>
        }
    </nav>

    <section class="catalog-toolbar">
        <div class="catalog-filter-bar">
            <label>
                <span>Название</span>
                <input type="search" id="filterName" placeholder="Поиск по названию" />
            </label>

            <label>
                <span>Достижения</span>
                <input type="number" id="filterAchievements" placeholder="Минимум" min="0" max="@maxAchievementFilter" />
            </label>

            <div class="catalog-filter-actions">
                <button id="applyFilters" type="button">Применить</button>
                <button id="resetFilters" type="button" class="secondary-btn">Сбросить</button>
            </div>
        </div>
    </section>

    <section class="catalog-wrapper" id="catalog-feedback">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="catalog-alert success-alert">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="catalog-alert error-alert">
                @TempData["ErrorMessage"]
            </div>
        }

        <section class="catalog">
            @foreach (var game in Model)
            {
                var description = System.Net.WebUtility.HtmlDecode(game.Description ?? "");

                <a asp-controller="Games"
                   asp-action="Details"
                   asp-route-id="@game.Id"
                   class="game-card-link">

                    <div class="card game-card"
                         data-name="@(game.Name ?? "")"
                         data-achievements="@(achievementCounts.TryGetValue(game.Id, out var cnt) ? cnt : 0)">

                        <div class="game-image-wrap">
                            <img src="@game.AvatarUrl" alt="@game.Name" class="game-image" />
                        </div>

                        <div class="game-content">
                            <h3>@game.Name</h3>
                            <p class="game-description">
                                @(string.IsNullOrWhiteSpace(description)
                                                            ? "Описание пока отсутствует."
                                                            : description)
                        </p>
                        <span class="achievements-count">
                            🏆 @(achievementCounts.TryGetValue(game.Id, out var count) ? count : 0) достижений
                        </span>
                    </div>
                </div>
            </a>
            }

            <div class="card add-game-card" id="openAddGame">
                <div class="add-game-inner">
                    <div class="add-game-plus">+</div>
                    <div class="add-game-title">Отправить заявку</div>
                    <div class="add-game-subtitle">
                        Предложить новую игру для добавления в каталог
                    </div>
                </div>
            </div>
        </section>
    </section>
</main>

<div id="addGameModal" class="add-game-modal hidden">
    <div class="modal-overlay" id="closeModalOverlay"></div>

    <div class="modal-content">
        <div class="modal-header">
            <h3>Заявка на добавление игры</h3>
            <button type="button" class="modal-close" id="cancelModalTop">×</button>
        </div>

        <p class="modal-description">
            Вставь ссылку на игру в Steam. Игра не добавится сразу в каталог, а сначала уйдёт на проверку администратору.
        </p>

        <form id="addGameForm" asp-controller="Games" asp-action="AddFromSteam" method="post">
            @Html.AntiForgeryToken()

            <input type="text"
                   id="steamUrl"
                   name="steamUrl"
                   placeholder="https://store.steampowered.com/app/12345"
                   maxlength="@GameRequest.UrlMaxLength"
                   required />

            <div class="modal-buttons">
                <button type="submit" class="primary-btn">Отправить заявку</button>
                <button type="button" id="cancelModal" class="secondary-btn">Отмена</button>
            </div>
        </form>
    </div>
</div>

<script src="~/js/catalog.js"></script>
