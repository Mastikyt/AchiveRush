@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using WebApplication1.Models
@using WebApplication1.Services
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject ApplicationDbContext Db
@inject AdminAccessService AdminAccess
@inject QuestProgressService QuestProgress

@functions {
    private static string DifficultyLabel(string value) => value switch
    {
        ChallengeDifficulties.Easy => "Легко",
        ChallengeDifficulties.Normal => "Нормально",
        ChallengeDifficulties.Hard => "Сложно",
        ChallengeDifficulties.Legendary => "Легендарно",
        _ => value
    };
}

<header>
    <div class="header-left">
        <a asp-controller="Home" asp-action="Index" class="logo">AchiveRush</a>
        <nav>
            <a asp-controller="Home" asp-action="Catalog">Каталог игр</a>
            <a asp-controller="Home" asp-action="Leaderboard">Таблица лидеров</a>
            <a asp-controller="Challenges" asp-action="Index">Челленджи</a>
        </nav>
    </div>

    <div class="header-right">
        @if (SignInManager.IsSignedIn(User))
        {
            var identityUser = await UserManager.GetUserAsync(User);

            var publicUser = identityUser != null && !string.IsNullOrWhiteSpace(identityUser.SteamId)
            ? await Db.Users.FirstOrDefaultAsync(x => x.SteamId == identityUser.SteamId)
            : null;

            var avatarUrl = !string.IsNullOrWhiteSpace(publicUser?.AvatarID)
            ? publicUser!.AvatarID
            : (!string.IsNullOrWhiteSpace(identityUser?.AvatarUrl) ? identityUser!.AvatarUrl : "/images/default_avatar.png");

            var personaName = !string.IsNullOrWhiteSpace(publicUser?.SteamName)
            ? publicUser!.SteamName
            : (!string.IsNullOrWhiteSpace(identityUser?.PersonaName) ? identityUser!.PersonaName : "Player");

            var canOpenAdmin = await AdminAccess.IsAllowedAsync(identityUser);
            var unreadNotificationsCount = publicUser == null
                ? 0
                : await Db.Notifications.CountAsync(x => x.UserId == publicUser.Id && x.ReadAt == null);
            var notifications = publicUser == null
                ? new List<Notification>()
                : await Db.Notifications
                    .Where(x => x.UserId == publicUser.Id)
                    .OrderByDescending(x => x.CreatedAt)
                    .Take(8)
                    .ToListAsync();
            var dailyQuest = publicUser == null
                ? null
                : await QuestProgress.EvaluateDailyQuestAsync(publicUser.Id);
            var dailyReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

            <div class="daily-quest-widget">
                <button type="button" class="daily-quest-toggle" aria-label="Ежедневный квест">
                    <span class="daily-quest-icon">XP</span>
                    @if (dailyQuest?.Completed == true)
                    {
                        <span class="daily-quest-dot done"></span>
                    }
                    else if (dailyQuest != null)
                    {
                        <span class="daily-quest-dot"></span>
                    }
                </button>

                <div class="daily-quest-menu">
                    <div class="daily-quest-menu-head">
                        <strong>Ежедневный квест</strong>
                        @if (dailyQuest != null)
                        {
                            <span>+@dailyQuest.DailyQuest.RewardExperience XP</span>
                        }
                    </div>

                    @if (dailyQuest == null)
                    {
                        <div class="daily-quest-empty">Войди через Steam, чтобы получить задание дня.</div>
                    }
                    else
                    {
                        var dailyProgressPercent = dailyQuest.DailyQuest.TargetValue <= 0
                            ? 0
                            : Math.Min(100, (int)Math.Round(dailyQuest.ProgressValue * 100.0 / dailyQuest.DailyQuest.TargetValue));

                        <div class="daily-quest-card">
                            <div class="daily-quest-title">@dailyQuest.DailyQuest.Title</div>
                            <p>@dailyQuest.DailyQuest.Description</p>

                            <div class="daily-quest-inline">
                                <span>@DifficultyLabel(dailyQuest.DailyQuest.Difficulty)</span>
                                <strong>@dailyQuest.ProgressValue / @dailyQuest.DailyQuest.TargetValue</strong>
                            </div>

                            <div class="daily-quest-progress-bar">
                                <div style="width:@dailyProgressPercent%"></div>
                            </div>

                            <div class="daily-quest-actions">
                                <form asp-controller="Challenges" asp-action="RefreshDaily" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@dailyReturnUrl" />
                                    <button type="submit">Обновить</button>
                                </form>

                                <form asp-controller="Challenges" asp-action="RerollDaily" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@dailyReturnUrl" />
                                    <button type="submit" disabled="@(dailyQuest.Completed || dailyQuest.RerolledAt.HasValue)">Сменить</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="notifications-widget">
                <button type="button" class="notifications-toggle" aria-label="Уведомления">
                    <svg class="notification-bell" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    @if (unreadNotificationsCount > 0)
                    {
                        <span class="notification-count">@(unreadNotificationsCount > 99 ? "99+" : unreadNotificationsCount)</span>
                    }
                </button>

                <div class="notifications-menu">
                    <div class="notifications-head">
                        <strong>Уведомления</strong>
                        @if (notifications.Any())
                        {
                            <div class="notifications-actions">
                                @if (unreadNotificationsCount > 0)
                                {
                            <form asp-controller="Notifications" asp-action="MarkAllRead" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit">Прочитать все</button>
                            </form>
                                }
                                <form asp-controller="Notifications" asp-action="ClearAll" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="notifications-clear">РћС‡РёСЃС‚РёС‚СЊ</button>
                                </form>
                            </div>
                        }
                    </div>

                    @if (!notifications.Any())
                    {
                        <div class="notification-empty">Пока пусто.</div>
                    }
                    else
                    {
                        @foreach (var notification in notifications)
                        {
                            <a class="notification-item @(notification.ReadAt == null ? "unread" : "")"
                               asp-controller="Notifications"
                               asp-action="Open"
                               asp-route-id="@notification.Id">
                                <span>@notification.Title</span>
                                <small>@notification.Message</small>
                                <em>@notification.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</em>
                            </a>
                        }
                    }
                </div>
            </div>

            <div class="user-info dropdown">
                <img src="@avatarUrl" class="avatar" alt="Avatar" />
                <div class="dropdown-toggle">@personaName</div>

                <div class="dropdown-menu">
                    <a class="dropdown-item"
                       asp-controller="Profile"
                       asp-action="UserProfile"
                       asp-route-steamId="@identityUser?.SteamId">
                        Профиль
                    </a>

                    @if (canOpenAdmin)
                    {
                        <a class="dropdown-item" href="/secret-admin">
                            Админка
                        </a>
                    }

                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item logout-btn">Выйти</button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="steam-badge">
                <a asp-controller="Account" asp-action="Login" class="steam-login-button" aria-label="Войти через Steam">
                    <span class="steam-login-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <circle cx="12" cy="12" r="10" />
                            <circle cx="16.6" cy="8.1" r="2.3" />
                            <circle cx="8" cy="15.5" r="2.2" />
                            <path d="M10 14.5l4.7-3.3M7.1 13.6l-3.2-1.3" />
                        </svg>
                    </span>
                    <span>Войти через Steam</span>
                </a>
            </div>
        }
    </div>
</header>

<style>
    .header-left {
        display: flex;
        align-items: center;
        gap: clamp(18px, 3vw, 36px);
        min-width: 0;
    }

    nav a {
        min-height: 44px;
        color: #e6c87a;
        text-decoration: none;
        padding: 10px 15px;
        border-radius: 8px;
        transition: .2s;
        text-align: center;
    }

        nav a:hover {
            background: rgba(212, 175, 55, 0.18);
        }

    .header-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 15px;
        min-width: 0;
    }

    .steam-badge {
        position: static;
        right: auto;
        bottom: auto;
        display: flex;
        align-items: center;
        color: inherit;
        font-size: inherit;
        font-weight: inherit;
        backdrop-filter: none;
    }

    .steam-login-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 44px;
        padding: 0 16px 0 12px;
        border-radius: 8px;
        border: 1px solid rgba(212, 175, 55, 0.42);
        background: linear-gradient(135deg, rgba(212, 175, 55, 0.16), rgba(30, 26, 20, 0.96));
        color: #f2d77f;
        text-decoration: none;
        font-size: 15px;
        font-weight: 800;
        line-height: 1;
        white-space: nowrap;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 10px 24px rgba(0, 0, 0, 0.24);
        transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
    }

        .steam-login-button:hover {
            transform: translateY(-1px);
            border-color: #d4af37;
            background: linear-gradient(135deg, rgba(212, 175, 55, 0.24), rgba(42, 36, 26, 0.98));
            color: #fff3e0;
        }

        .steam-login-button:focus-visible {
            outline: 3px solid rgba(212, 175, 55, 0.32);
            outline-offset: 3px;
        }

    .steam-login-icon {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        background: #d4af37;
        color: #12100c;
    }

        .steam-login-icon svg {
            width: 21px;
            height: 21px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .steam-login-icon circle:first-child {
            fill: currentColor;
            opacity: 0.16;
        }

    .user-info.dropdown {
        position: relative;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .user-info .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
    }

    .user-info .dropdown-toggle {
        color: #fff;
        font-weight: bold;
        margin-left: 8px;
    }

    .dropdown-menu {
        display: none;
        position: absolute;
        top: 50px;
        right: 0;
        background: rgba(20,20,40,.95);
        border-radius: 8px;
        min-width: 150px;
        padding: 5px 0;
        z-index: 200;
        box-shadow: 0 5px 20px rgba(0,0,0,0.5);
    }

        .dropdown-menu a, .dropdown-menu button {
            display: block;
            padding: 10px 15px;
            color: #fff;
            text-decoration: none;
            width: 100%;
            text-align: left;
            border: none;
            background: none;
            cursor: pointer;
        }

            .dropdown-menu a:hover, .dropdown-menu button:hover {
                background: rgba(138, 43, 226, 0.3);
            }

    .user-info.dropdown:hover .dropdown-menu {
        display: block;
    }

    .daily-quest-widget {
        position: relative;
    }

    .daily-quest-toggle {
        position: relative;
        width: 42px;
        height: 42px;
        border: 1px solid rgba(212, 175, 55, 0.38);
        border-radius: 50%;
        background: rgba(212, 175, 55, 0.13);
        color: #f3d58e;
        padding: 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .daily-quest-icon {
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 0;
    }

    .daily-quest-dot {
        position: absolute;
        top: -4px;
        right: -4px;
        width: 14px;
        height: 14px;
        border-radius: 999px;
        background: #f59e0b;
        border: 2px solid #0a0805;
    }

        .daily-quest-dot.done {
            background: #34d399;
        }

    .daily-quest-menu {
        display: none;
        position: absolute;
        top: 48px;
        right: 0;
        width: min(360px, 88vw);
        max-height: min(460px, calc(100vh - 96px));
        overflow-y: auto;
        z-index: 225;
        padding: 12px;
        border-radius: 8px;
        background: rgba(10, 8, 5, 0.98);
        border: 1px solid rgba(212, 175, 55, 0.32);
        box-shadow: 0 16px 38px rgba(0, 0, 0, 0.55);
    }

    .daily-quest-widget:hover .daily-quest-menu,
    .daily-quest-widget:focus-within .daily-quest-menu {
        display: block;
    }

    .daily-quest-menu-head,
    .daily-quest-inline,
    .daily-quest-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .daily-quest-menu-head {
        color: #f5e7c8;
        margin-bottom: 10px;
    }

        .daily-quest-menu-head span {
            color: #a7f3d0;
            font-weight: 900;
        }

    .daily-quest-card,
    .daily-quest-empty {
        border-radius: 8px;
        background: rgba(212, 175, 55, 0.07);
        border: 1px solid rgba(212, 175, 55, 0.16);
        padding: 12px;
    }

    .daily-quest-title {
        color: #fef3d6;
        font-weight: 900;
        margin-bottom: 6px;
        overflow-wrap: anywhere;
    }

    .daily-quest-card p {
        margin: 0 0 12px;
        color: #dcbc6a;
        line-height: 1.45;
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    .daily-quest-inline {
        color: #f3d58e;
        font-size: 13px;
        font-weight: 800;
    }

    .daily-quest-progress-bar {
        height: 8px;
        margin: 9px 0 12px;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
    }

        .daily-quest-progress-bar div {
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #d4af37, #34d399);
        }

    .daily-quest-actions form {
        flex: 1;
    }

    .daily-quest-actions button {
        width: 100%;
        min-height: 36px;
        border-radius: 8px;
        border: 1px solid rgba(212, 175, 55, 0.3);
        background: rgba(212, 175, 55, 0.12);
        color: #f3d58e;
        font-weight: 800;
        cursor: pointer;
    }

        .daily-quest-actions button:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

    .notifications-widget {
        position: relative;
    }

    .notifications-toggle {
        position: relative;
        width: 42px;
        height: 42px;
        border: 1px solid rgba(201, 160, 61, 0.35);
        border-radius: 50%;
        background: rgba(201, 160, 61, 0.12);
        color: #f5e7c8;
        padding: 0;
        font-weight: 800;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .notifications-toggle .notification-bell {
            width: 21px;
            height: 21px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .notifications-toggle .notification-count {
            position: absolute;
            top: -6px;
            right: -7px;
            display: inline-flex;
            min-width: 22px;
            height: 22px;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: #c2410c;
            color: #fff;
            font-size: 12px;
        }

    .notifications-menu {
        display: none;
        position: absolute;
        top: 48px;
        right: 0;
        width: min(360px, 88vw);
        max-height: min(460px, calc(100vh - 96px));
        overflow: auto;
        z-index: 220;
        padding: 10px;
        border-radius: 8px;
        background: rgba(10, 8, 5, 0.98);
        border: 1px solid rgba(201, 160, 61, 0.32);
        box-shadow: 0 16px 38px rgba(0, 0, 0, 0.55);
    }

    .notifications-widget:hover .notifications-menu,
    .notifications-widget:focus-within .notifications-menu {
        display: block;
    }

    .notifications-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 6px 6px 10px;
        color: #f5e7c8;
    }

    .notifications-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
    }

        .notifications-head button {
            border: none;
            background: none;
            color: #e9c468;
            font-weight: 700;
            cursor: pointer;
        }

        .notifications-head .notifications-clear {
            color: #fca5a5;
            font-size: 0;
        }

            .notifications-head .notifications-clear::after {
                content: "\041E\0447\0438\0441\0442\0438\0442\044C";
                font-size: 13px;
            }

    .notification-item {
        display: block;
        padding: 10px;
        border-radius: 8px;
        color: #f5e7c8;
        text-decoration: none;
        border: 1px solid transparent;
    }

        .notification-item:hover,
        .notification-item.unread {
            background: rgba(201, 160, 61, 0.12);
            border-color: rgba(201, 160, 61, 0.22);
        }

        .notification-item span {
            display: block;
            font-weight: 900;
            margin-bottom: 4px;
        }

        .notification-item small {
            display: block;
            color: #e9c468;
            line-height: 1.35;
            overflow-wrap: anywhere;
        }

        .notification-item em {
            display: block;
            margin-top: 5px;
            color: rgba(245, 231, 200, 0.64);
            font-style: normal;
            font-size: 12px;
        }

    .notification-empty {
        padding: 14px 10px;
        color: #e9c468;
    }

    @@media (max-width: 1100px) {
        header {
            flex-wrap: wrap;
            gap: 16px;
        }

        .header-left {
            flex: 1 1 100%;
            justify-content: space-between;
        }

        nav {
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 10px;
        }

        .header-right {
            width: 100%;
            justify-content: flex-end;
        }
    }

    @@media (max-width: 768px) {
        header {
            padding: 18px 16px;
        }

        .header-left {
            flex-direction: column;
            align-items: stretch;
            gap: 14px;
        }

        .logo {
            text-align: center;
            line-height: 1;
        }

        nav {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
            width: 100%;
        }

            nav a {
                width: 100%;
                min-height: 42px;
                padding: 9px 8px;
                justify-content: center;
                white-space: normal;
                line-height: 1.15;
                font-size: 13px;
            }

        .header-right {
            justify-content: center;
            flex-wrap: wrap;
        }

        .daily-quest-widget,
        .notifications-widget {
            position: static;
        }

        .daily-quest-toggle,
        .notifications-toggle {
            width: 46px;
            height: 46px;
        }

        .steam-badge,
        .steam-login-button {
            width: 100%;
        }

        .steam-login-button {
            min-height: 46px;
        }

        .user-info.dropdown {
            max-width: 100%;
        }

        .user-info .dropdown-toggle {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .daily-quest-menu,
        .notifications-menu {
            position: fixed;
            top: max(12px, env(safe-area-inset-top));
            left: 12px;
            right: 12px;
            width: auto;
            max-height: calc(100dvh - 24px);
            overflow-y: auto;
            transform: none;
            z-index: 500;
        }

        .daily-quest-menu-head,
        .daily-quest-inline {
            align-items: flex-start;
        }

        .daily-quest-menu-head {
            flex-wrap: wrap;
        }

        .daily-quest-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .daily-quest-actions form {
            width: 100%;
        }

        .daily-quest-actions button {
            min-height: 42px;
        }

        .notifications-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .notifications-actions {
            width: 100%;
            justify-content: stretch;
            gap: 8px;
        }

        .notifications-actions form {
            flex: 1 1 140px;
        }

        .notifications-head button {
            width: 100%;
            min-height: 36px;
            padding: 8px 10px;
            border-radius: 8px;
            border: 1px solid rgba(212, 175, 55, 0.22);
            background: rgba(212, 175, 55, 0.1);
            text-align: center;
        }

        .notification-item {
            padding: 12px;
        }

        .notification-item span {
            overflow-wrap: anywhere;
        }
    }

    @@media (max-width: 420px) {
        nav {
            grid-template-columns: 1fr;
        }

        .daily-quest-menu,
        .notifications-menu {
            left: 8px;
            right: 8px;
            max-height: calc(100dvh - 16px);
        }

        .daily-quest-inline {
            flex-direction: column;
            gap: 4px;
        }

        .notifications-actions {
            flex-direction: column;
        }
    }
</style>
