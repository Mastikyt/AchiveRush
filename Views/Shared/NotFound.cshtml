@model string
@{
    ViewData["Title"] = "Страница не найдена";
    var message = string.IsNullOrWhiteSpace(Model) ? "Страница не найдена или недоступна." : Model;
}

<section class="not-found-page">
    <div class="not-found-card">
        <div class="not-found-code">404</div>
        <h1>Ничего не найдено</h1>
        <p>@message</p>
        <a asp-controller="Home" asp-action="Index" class="not-found-link">На главную</a>
    </div>
</section>

<style>
    .not-found-page {
        min-height: calc(100vh - 250px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: transparent;
        color: #fef3d6;
    }
    .not-found-card {
        max-width: 620px;
        width: 100%;
        text-align: center;
        padding: 42px 30px;
        border-radius: 30px;
        background: linear-gradient(180deg, rgba(33,27,20,.96), rgba(18,14,10,.96));
        border: 1px solid rgba(212,175,55,.18);
        box-shadow: 0 24px 60px rgba(0,0,0,.28);
    }
    .not-found-code {
        font-size: clamp(4rem, 14vw, 9rem);
        line-height: .9;
        font-weight: 900;
        color: #d4af37;
        margin-bottom: 18px;
    }
    .not-found-card h1 {
        margin: 0 0 12px;
        font-size: 2rem;
    }
    .not-found-card p {
        margin: 0 auto 26px;
        color: #dcbc6a;
        line-height: 1.6;
    }
    .not-found-link {
        display: inline-flex;
        padding: 13px 20px;
        border-radius: 14px;
        color: #0b0907;
        background: #d4af37;
        text-decoration: none;
        font-weight: 800;
    }
</style>
