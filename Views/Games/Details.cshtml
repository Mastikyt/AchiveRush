@model WebApplication1.Models.GameDetailsViewModel
@using System.Net

@{
    ViewData["Title"] = Model.Game.Name;
    var gameDescription = WebUtility.HtmlDecode(Model.Game.Description ?? "");
    var completionPercent = Model.TotalAchievements == 0
        ? 0
        : (int)Math.Round((double)Model.CompletedAchievements / Model.TotalAchievements * 100);
    var visibleAchievements = Model.AchievementItems
        .Where(x => !x.IsHidden)
        .ToList();
    var hiddenAchievements = Model.AchievementItems
        .Where(x => x.IsHidden)
        .ToList();
}

<section class="game-page">
    <div class="game-layout">
        <div class="game-main-card">
            <div class="game-main-top">
                <div class="game-cover-wrap">
                    <img src="@Model.Game.AvatarUrl" alt="@Model.Game.Name" class="game-cover" />
                </div>

                <div class="game-main-content">
                    <h1 class="game-title">@Model.Game.Name</h1>

                    <div class="game-description">
                        @(string.IsNullOrWhiteSpace(gameDescription)
                            ? "Описание игры пока отсутствует."
                            : gameDescription)
                    </div>

                    <div class="game-stats">
                        <div class="game-stat">
                            <div class="game-stat-value">@Model.TotalAchievements</div>
                            <div class="game-stat-label">Всего ачивок</div>
                        </div>

                        <div class="game-stat">
                            <div class="game-stat-value">@Model.CompletedAchievements</div>
                            <div class="game-stat-label">Выполнено</div>
                        </div>

                        <div class="game-stat">
                            <div class="game-stat-value">@completionPercent%</div>
                            <div class="game-stat-label">Прогресс</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <section class="game-achievements-panel">
            <div class="game-achievements-head">
                <div>
                    <h2>Достижения</h2>
                    <span>@Model.CompletedAchievements из @Model.TotalAchievements получено</span>
                </div>

                @if (Model.CanAddCustomAchievement)
                {
                    <button type="button" class="add-achievement-toggle" id="toggleCustomAchievement" aria-label="Добавить достижение">
                        <span>+</span>
                        Добавить достижение
                    </button>
                }
            </div>

            @if (TempData["GameDetailsSuccess"] is string successMessage)
            {
                <div class="game-details-alert success">@successMessage</div>
            }

            @if (TempData["GameDetailsError"] is string errorMessage)
            {
                <div class="game-details-alert error">@errorMessage</div>
            }

            @if (Model.CanAddCustomAchievement)
            {
                <form asp-controller="Games" asp-action="AddCustomAchievement" method="post" class="custom-achievement-form hidden" id="customAchievementForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="GameId" value="@Model.Game.Id" />

                    <div class="custom-achievement-grid">
                        <input type="text" name="Title" placeholder="Название" maxlength="@CustomAchievementInputModel.TitleMaxLength" required />
                        <input type="url" name="IconUrl" placeholder="Ссылка на иконку" maxlength="@CustomAchievementInputModel.IconUrlMaxLength" />
                        <textarea name="Description" placeholder="Описание" maxlength="@CustomAchievementInputModel.DescriptionMaxLength" required></textarea>
                        <textarea name="ObtainMethod" placeholder="Способ получения" maxlength="@CustomAchievementInputModel.ObtainMethodMaxLength" required></textarea>
                    </div>

                    <div class="custom-achievement-actions">
                        <button type="submit" class="custom-achievement-submit">Отправить на проверку</button>
                        <button type="button" class="custom-achievement-cancel" id="cancelCustomAchievement">Отмена</button>
                    </div>
                </form>
            }

            @if (Model.AchievementItems.Any())
            {
                <div class="game-achievements-list">
                    @foreach (var achievement in visibleAchievements)
                    {
                        <article class="game-achievement @(achievement.IsCompleted ? "completed" : "locked") @(achievement.IsCustom ? "custom" : "")">
                            <img src="@achievement.IconUrl" alt="@achievement.Title" class="game-achievement-icon" loading="lazy" />

                            <div class="game-achievement-content">
                                <div class="game-achievement-title">@achievement.Title</div>
                                <div class="game-achievement-description">
                                    @(string.IsNullOrWhiteSpace(achievement.Description)
                                        ? "Без описания"
                                        : WebUtility.HtmlDecode(achievement.Description))
                                </div>

                                @if (!string.IsNullOrWhiteSpace(achievement.ObtainMethod))
                                {
                                    <div class="game-achievement-method">@WebUtility.HtmlDecode(achievement.ObtainMethod)</div>
                                }

                                <div class="game-achievement-meta">
                                    @if (achievement.IsCustom)
                                    {
                                        <span>Пользовательское достижение</span>
                                    }
                                    else if (achievement.GlobalUnlockRate > 0)
                                    {
                                        <span>Это достижение есть у @achievement.GlobalUnlockRate.ToString("0.##")% игроков</span>
                                    }
                                    else
                                    {
                                        <span>Редкость пока неизвестна</span>
                                    }
                                </div>
                            </div>

                            <div class="game-achievement-state">
                                @if (achievement.IsCompleted && achievement.UnlockTime.HasValue)
                                {
                                    <span>Получено @achievement.UnlockTime.Value.ToLocalTime().ToString("dd.MM.yyyy, HH:mm")</span>
                                }
                                else if (achievement.IsCompleted)
                                {
                                    <span>Получено</span>
                                }
                                else if (achievement.HasPendingCompletionRequest)
                                {
                                    <span>На проверке</span>
                                }
                                else
                                {
                                    <span>Не получено</span>
                                }

                                @if (achievement.CanRequestCompletion)
                                {
                                    <details class="custom-claim-box">
                                        <summary>Получить достижение</summary>
                                        <form asp-controller="Games" asp-action="RequestCustomAchievementCompletion" method="post" class="custom-claim-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="achievementId" value="@achievement.AchievementId" />
                                            <input type="url" name="proofUrl" placeholder="Ссылка на скриншот, видео или профиль (необязательно)" maxlength="@CustomAchievementClaimRequest.ProofUrlMaxLength" />
                                            <textarea name="comment" placeholder="Комментарий (необязательно)" maxlength="@CustomAchievementClaimRequest.CommentMaxLength"></textarea>
                                            <button type="submit">Добавить в профиль</button>
                                        </form>
                                    </details>
                                }

                                @if (achievement.CanDeleteCustomAchievement)
                                {
                                    <form asp-controller="Games"
                                          asp-action="DeleteCustomAchievement"
                                          method="post"
                                          class="custom-delete-form"
                                          onsubmit="return confirm('Удалить пользовательское достижение? Оно пропадет из профилей пользователей.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="achievementId" value="@achievement.AchievementId" />
                                        <button type="submit">Удалить кастомное</button>
                                    </form>
                                }
                            </div>
                        </article>
                    }
                </div>

                @if (hiddenAchievements.Any())
                {
                    <section class="hidden-achievements-section" aria-label="Скрытые достижения">
                        <div class="hidden-achievements-head">
                            <div>
                                <span class="hidden-achievements-kicker">Скрытые</span>
                                <h3>Скрытые достижения</h3>
                            </div>
                            <span>@hiddenAchievements.Count</span>
                        </div>

                        <div class="game-achievements-list hidden-achievements-list">
                            @foreach (var achievement in hiddenAchievements)
                            {
                                var revealHidden = achievement.IsCompleted;

                                <article class="game-achievement hidden-achievement @(achievement.IsCompleted ? "completed" : "locked")">
                                    @if (revealHidden)
                                    {
                                        <img src="@achievement.IconUrl" alt="@achievement.Title" class="game-achievement-icon" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="game-achievement-icon hidden-achievement-icon" aria-hidden="true">?</div>
                                    }

                                    <div class="game-achievement-content">
                                        <div class="game-achievement-title">
                                            @(revealHidden ? achievement.Title : "Скрытое достижение")
                                        </div>
                                        <div class="game-achievement-description">
                                            @if (revealHidden)
                                            {
                                                @(string.IsNullOrWhiteSpace(achievement.Description)
                                                    ? "Без описания"
                                                    : WebUtility.HtmlDecode(achievement.Description))
                                            }
                                            else
                                            {
                                                <text>Подробности появятся после получения.</text>
                                            }
                                        </div>

                                        @if (revealHidden && !string.IsNullOrWhiteSpace(achievement.ObtainMethod))
                                        {
                                            <div class="game-achievement-method">@WebUtility.HtmlDecode(achievement.ObtainMethod)</div>
                                        }

                                        <div class="game-achievement-meta">
                                            @if (revealHidden && achievement.GlobalUnlockRate > 0)
                                            {
                                                <span>Это достижение есть у @achievement.GlobalUnlockRate.ToString("0.##")% игроков</span>
                                            }
                                            else
                                            {
                                                <span>Скрыто Steam</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="game-achievement-state">
                                        @if (achievement.IsCompleted && achievement.UnlockTime.HasValue)
                                        {
                                            <span>Получено @achievement.UnlockTime.Value.ToLocalTime().ToString("dd.MM.yyyy, HH:mm")</span>
                                        }
                                        else if (achievement.IsCompleted)
                                        {
                                            <span>Получено</span>
                                        }
                                        else
                                        {
                                            <span>Не получено</span>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }
            }
            else
            {
                <div class="game-achievements-empty">У этой игры нет ачивок в базе.</div>
            }
        </section>
    </div>
</section>

<script>
    (() => {
        const toggle = document.getElementById('toggleCustomAchievement');
        const form = document.getElementById('customAchievementForm');
        const cancel = document.getElementById('cancelCustomAchievement');

        toggle?.addEventListener('click', () => {
            form?.classList.toggle('hidden');
        });

        cancel?.addEventListener('click', () => {
            form?.classList.add('hidden');
        });
    })();
</script>
