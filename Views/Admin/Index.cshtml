@model WebApplication1.Models.AdminIndexViewModel

@{
    ViewData["Title"] = "Админка";
    var pendingCount = Model.PendingRequestsCount;
    var approvedCount = Model.ApprovedRequestsCount;
    var rejectedCount = Model.RejectedRequestsCount;
    var deletedCount = Model.DeletedRequestsCount;
    var gamesCount = Model.GamesTotalCount;
}

<div class="admin-page">
    <div class="admin-container">

        <div class="admin-header">
            <div>
                <div class="admin-badge">AchiveRush Control Panel</div>
                <h1>Админка</h1>
                <p>Проверка заявок на добавление игр и заявок на игры, новые достижения и подтверждение кастомных ачивок.</p>
            </div>

            <form method="post" asp-controller="Admin" asp-action="Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="admin-logout-btn">Выйти</button>
            </form>
        </div>

        @if (TempData["AdminSuccess"] != null)
        {
            <div class="admin-flash admin-flash-success">@TempData["AdminSuccess"]</div>
        }

        @if (TempData["AdminError"] != null)
        {
            <div class="admin-flash admin-flash-error">@TempData["AdminError"]</div>
        }

        <div class="admin-stats">
            <div class="admin-stat-card">
                <span>Ожидают</span>
                <strong>@pendingCount</strong>
            </div>
            <div class="admin-stat-card">
                <span>Одобрено</span>
                <strong>@approvedCount</strong>
            </div>
            <div class="admin-stat-card">
                <span>Отклонено</span>
                <strong>@rejectedCount</strong>
            </div>
            <div class="admin-stat-card">
                <span>Удалено</span>
                <strong>@deletedCount</strong>
            </div>
            <div class="admin-stat-card">
                <span>В каталоге</span>
                <strong>@gamesCount</strong>
            </div>
        </div>

        <section class="admin-section" id="admin-games">
            <div class="admin-section-head">
                <h2>Игры в каталоге</h2>
                <p>Удаление игры также удалит её достижения из профилей пользователей и пересчитает их статистику.</p>
                <form method="post" asp-controller="Admin" asp-action="RefreshAllGameLocalizations" asp-route-requestsPage="@Model.RequestsPage" asp-route-gamesPage="@Model.GamesPage" class="admin-inline-action">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-refresh">Обновить русский для всех</button>
                </form>
            </div>

            @if (!Model.Games.Any())
            {
                <div class="admin-empty">
                    В каталоге пока нет игр.
                </div>
            }
            else
            {
                <div class="admin-grid">
                    @foreach (var game in Model.Games)
                    {
                        <div class="request-card">
                            <div class="request-image-wrap">
                                <img src="@game.AvatarUrl" alt="@game.Name" class="request-image" />
                                <div class="request-status approved">В каталоге</div>
                            </div>

                            <div class="request-body">
                                <h3>@game.Name</h3>

                                <div class="request-meta">
                                    <div class="request-meta-item">
                                        <span>Steam App ID</span>
                                        <strong>@game.SteamAppId</strong>
                                    </div>
                                    <div class="request-meta-item">
                                        <span>Достижений</span>
                                        <strong>@game.AchievementsCount</strong>
                                    </div>
                                    <div class="request-meta-item">
                                        <span>Записей в профилях</span>
                                        <strong>@game.ProfileAchievementsCount</strong>
                                    </div>
                                </div>

                                <div class="request-actions">
                                    <form method="post"
                                          asp-controller="Admin"
                                          asp-action="RefreshGameLocalization" asp-route-requestsPage="@Model.RequestsPage" asp-route-gamesPage="@Model.GamesPage">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@game.Id" />
                                        <button type="submit" class="btn-refresh">Обновить русский</button>
                                    </form>

                                    <form method="post"
                                          asp-controller="Admin"
                                          asp-action="DeleteGame" asp-route-requestsPage="@Model.RequestsPage" asp-route-gamesPage="@Model.GamesPage"
                                          data-admin-dynamic-form
                                          data-confirm="Удалить эту игру? Все её достижения будут удалены из профилей пользователей.">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@game.Id" />
                                        <button type="submit" class="btn-delete">Удалить игру</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (Model.GamesTotalPages > 1)
                {
                    <div class="admin-pagination">
                        @for (var i = 1; i <= Model.GamesTotalPages; i++)
                        {
                            <a class="@(i == Model.GamesPage ? "active" : "")"
                               asp-controller="Admin"
                               asp-action="Index"
                               asp-route-gamesPage="@i"
                               asp-route-requestsPage="@Model.RequestsPage"
                               asp-fragment="admin-games">@i</a>
                        }
                    </div>
                }
            }
        </section>

        <section class="admin-section" id="game-requests">
            <div class="admin-section-head">
                <h2>Заявки на добавление игр</h2>
                <p>В основную БД игра попадает только после одобрения администратором.</p>
            </div>

            @if (!Model.Requests.Any())
            {
                <div class="admin-empty">
                    Пока нет ни одной заявки.
                </div>
            }
            else
            {
                <div class="admin-grid">
                    @foreach (var item in Model.Requests)
                    {
                        var statusClass = item.Status switch
                        {
                            "Approved" => "approved",
                            "Rejected" => "rejected",
                            "Deleted" => "deleted",
                            _ => "pending"
                        };

                        <div class="request-card">
                            <div class="request-image-wrap">
                                <img src="@item.ImageUrl" alt="@item.Name" class="request-image" />
                                <div class="request-status @statusClass">@item.Status</div>
                            </div>

                            <div class="request-body">
                                <h3>@item.Name</h3>

                                <div class="request-meta">
                                    <div class="request-meta-item">
                                        <span>Steam App ID</span>
                                        <strong>@item.SteamAppId</strong>
                                    </div>
                                    <div class="request-meta-item">
                                        <span>Достижений</span>
                                        <strong>@item.AchievementsCount</strong>
                                    </div>
                                </div>

                                <div class="request-link-box">
                                    <span>Ссылка на игру</span>
                                    <a href="@item.SteamUrl" target="_blank">@item.SteamUrl</a>
                                </div>

                                <div class="request-date">
                                    Создано: @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </div>

                                @if (item.Status == "Pending")
                                {
                                    <div class="request-actions">
                                        <form method="post" asp-controller="Admin" asp-action="ApproveGameRequest" asp-route-requestsPage="@Model.RequestsPage" asp-route-gamesPage="@Model.GamesPage" data-admin-dynamic-form>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn-approve">Одобрить</button>
                                        </form>

                                        <form method="post" asp-controller="Admin" asp-action="RejectGameRequest" asp-route-requestsPage="@Model.RequestsPage" asp-route-gamesPage="@Model.GamesPage" data-admin-dynamic-form>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn-reject">Отклонить</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (Model.RequestsTotalPages > 1)
                {
                    <div class="admin-pagination">
                        @for (var i = 1; i <= Model.RequestsTotalPages; i++)
                        {
                            <a class="@(i == Model.RequestsPage ? "active" : "")"
                               asp-controller="Admin"
                               asp-action="Index"
                               asp-route-requestsPage="@i"
                               asp-route-gamesPage="@Model.GamesPage"
                               asp-fragment="game-requests">@i</a>
                        }
                    </div>
                }
            }
        </section>

        <section class="admin-section" id="custom-achievement-requests">
            <div class="admin-section-head">
                <h2>Заявки на добавление достижений</h2>
                <p>Новые пользовательские достижения попадают в игру только после проверки.</p>
            </div>

            @if (!Model.CustomAchievementRequests.Any())
            {
                <div class="admin-empty">Нет заявок на добавление достижений.</div>
            }
            else
            {
                <div class="admin-grid">
                    @foreach (var item in Model.CustomAchievementRequests)
                    {
                        <div class="request-card">
                            <div class="request-image-wrap">
                                <img src="@(string.IsNullOrWhiteSpace(item.IconUrl) ? item.GameAvatarUrl : item.IconUrl)" alt="@item.Title" class="request-image" />
                                <div class="request-status pending">Pending</div>
                            </div>
                            <div class="request-body">
                                <h3>@item.Title</h3>
                                <div class="request-meta">
                                    <div class="request-meta-item"><span>Игра</span><strong>@item.GameName</strong></div>
                                    <div class="request-meta-item"><span>Автор</span><strong>@item.RequestedBy</strong></div>
                                </div>
                                <div class="request-link-box">
                                    <span>Описание</span>
                                    <div>@item.Description</div>
                                </div>
                                <div class="request-link-box">
                                    <span>Как получить</span>
                                    <div>@item.ObtainMethod</div>
                                </div>
                                <div class="request-date">Создано: @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                <div class="request-actions">
                                    <form method="post" asp-controller="Admin" asp-action="ApproveCustomAchievementRequest" asp-route-requestsPage="@Model.RequestsPage" asp-route-gamesPage="@Model.GamesPage">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn-approve">Подтвердить</button>
                                    </form>
                                    <form method="post" asp-controller="Admin" asp-action="RejectCustomAchievementRequest" asp-route-requestsPage="@Model.RequestsPage" asp-route-gamesPage="@Model.GamesPage">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn-reject">Отклонить</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="admin-section" id="custom-claim-requests">
            <div class="admin-section-head">
                <h2>Подтверждение получения пользовательских достижений</h2>
                <p>Для кастомных ачивок Steam не даёт автоматический факт выполнения, поэтому пользователь отправляет заявку, а админ подтверждает или отклоняет.</p>
            </div>

            @if (!Model.CustomAchievementClaimRequests.Any())
            {
                <div class="admin-empty">Нет заявок на подтверждение получения.</div>
            }
            else
            {
                <div class="admin-grid">
                    @foreach (var item in Model.CustomAchievementClaimRequests)
                    {
                        <div class="request-card">
                            <div class="request-image-wrap">
                                <img src="@item.GameAvatarUrl" alt="@item.GameName" class="request-image" />
                                <div class="request-status pending">Pending</div>
                            </div>
                            <div class="request-body">
                                <h3>@item.AchievementTitle</h3>
                                <div class="request-meta">
                                    <div class="request-meta-item"><span>Игра</span><strong>@item.GameName</strong></div>
                                    <div class="request-meta-item"><span>Пользователь</span><strong>@item.UserName</strong></div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Comment))
                                {
                                    <div class="request-link-box">
                                        <span>Комментарий</span>
                                        <div>@item.Comment</div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.ProofUrl))
                                {
                                    <div class="request-link-box">
                                        <span>Доказательство</span>
                                        <a href="@item.ProofUrl" target="_blank" rel="noopener noreferrer">@item.ProofUrl</a>
                                    </div>
                                }
                                <div class="request-date">Создано: @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                <div class="request-actions">
                                    <form method="post" asp-controller="Admin" asp-action="ApproveCustomAchievementClaimRequest" asp-route-requestsPage="@Model.RequestsPage" asp-route-gamesPage="@Model.GamesPage">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn-approve">Подтвердить</button>
                                    </form>
                                    <form method="post" asp-controller="Admin" asp-action="RejectCustomAchievementClaimRequest" asp-route-requestsPage="@Model.RequestsPage" asp-route-gamesPage="@Model.GamesPage">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn-reject">Отклонить</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

    </div>
</div>

<style>
    .admin-page {
        min-height: 100vh;
        padding: 36px 20px 60px;
        background: radial-gradient(circle at top left, rgba(212,175,55,0.08), transparent 28%), radial-gradient(circle at top right, rgba(212,175,55,0.06), transparent 30%), linear-gradient(180deg, #0b0907, #12100c 45%, #0f0d0a);
        color: #fef3d6;
    }

    .admin-container {
        max-width: 1280px;
        margin: 0 auto;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        align-items: flex-start;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .admin-badge {
        display: inline-block;
        margin-bottom: 14px;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(212,175,55,0.12);
        color: #e6c87a;
        font-weight: 700;
        font-size: 0.88rem;
        border: 1px solid rgba(212,175,55,0.18);
    }

    .admin-header h1 {
        margin: 0 0 8px;
        font-size: 2.4rem;
        font-weight: 800;
        color: #fef3d6;
    }

    .admin-header p {
        margin: 0;
        max-width: 760px;
        color: #dcbc6a;
        line-height: 1.6;
    }

    .admin-logout-btn {
        border: 1px solid rgba(212,175,55,0.2);
        background: rgba(212,175,55,0.06);
        color: #f3d58e;
        border-radius: 14px;
        padding: 12px 18px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .admin-logout-btn:hover {
            background: rgba(212,175,55,0.1);
            border-color: rgba(212,175,55,0.35);
        }

    .admin-flash {
        border-radius: 18px;
        padding: 14px 18px;
        margin-bottom: 18px;
        font-weight: 600;
    }

    .admin-flash-success {
        background: rgba(48, 158, 92, 0.12);
        border: 1px solid rgba(74, 222, 128, 0.18);
        color: #a7f3d0;
    }

    .admin-flash-error {
        background: rgba(185,40,40,0.12);
        border: 1px solid rgba(248,113,113,0.2);
        color: #fecaca;
    }

    .admin-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    .admin-stat-card {
        background: linear-gradient(180deg, rgba(33,27,20,0.95), rgba(24,20,14,0.95));
        border: 1px solid rgba(212,175,55,0.12);
        border-radius: 22px;
        padding: 22px;
        backdrop-filter: blur(8px);
    }

        .admin-stat-card span {
            display: block;
            color: #dcbc6a;
            margin-bottom: 10px;
            font-size: 0.95rem;
        }

        .admin-stat-card strong {
            font-size: 2rem;
            font-weight: 800;
            color: #fff;
        }

    .admin-section {
        background: linear-gradient(180deg, rgba(33,27,20,0.96), rgba(24,20,14,0.96));
        border: 1px solid rgba(212,175,55,0.14);
        border-radius: 28px;
        padding: 24px;
        margin-bottom: 26px;
        box-shadow: 0 16px 40px rgba(0,0,0,0.18);
    }

    .admin-section-head {
        margin-bottom: 22px;
    }

    .admin-inline-action {
        margin-top: 14px;
    }

        .admin-section-head h2 {
            margin: 0 0 8px;
            font-size: 1.55rem;
            font-weight: 800;
            color: #fef3d6;
        }

        .admin-section-head p {
            margin: 0;
            color: #dcbc6a;
            line-height: 1.55;
        }

    .admin-empty {
        padding: 22px;
        border-radius: 20px;
        background: rgba(255,255,255,0.03);
        color: #dcbc6a;
    }

    .admin-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 20px;
    }

    .request-card {
        overflow: hidden;
        border-radius: 24px;
        background: linear-gradient(180deg, rgba(33,27,20,0.98), rgba(24,20,14,0.98));
        border: 1px solid rgba(212,175,55,0.12);
        box-shadow: 0 14px 34px rgba(0,0,0,0.2);
    }

    .request-image-wrap {
        position: relative;
        height: 190px;
        overflow: hidden;
        background: #0f172a;
    }

    .request-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .request-status {
        position: absolute;
        top: 14px;
        right: 14px;
        border-radius: 999px;
        padding: 7px 12px;
        font-size: 0.82rem;
        font-weight: 700;
        backdrop-filter: blur(8px);
    }

        .request-status.pending {
            background: rgba(245,158,11,0.18);
            color: #fcd34d;
            border: 1px solid rgba(245,158,11,0.25);
        }

        .request-status.approved {
            background: rgba(48, 158, 92, 0.16);
            color: #a7f3d0;
            border: 1px solid rgba(74, 222, 128, 0.18);
        }

        .request-status.rejected {
            background: rgba(185,40,40,0.12);
            color: #fecaca;
            border: 1px solid rgba(248,113,113,0.2);
        }

        .request-status.deleted {
            background: rgba(148, 163, 184, 0.14);
            color: #cbd5e1;
            border: 1px solid rgba(148, 163, 184, 0.22);
        }

    .request-body {
        padding: 20px;
    }

        .request-body h3 {
            margin: 0 0 16px;
            font-size: 1.2rem;
            font-weight: 800;
            line-height: 1.35;
            color: #fef3d6;
        }

    .request-meta {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-bottom: 16px;
    }

    .request-meta-item {
        padding: 14px;
        border-radius: 16px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(212,175,55,0.08);
    }

        .request-meta-item span {
            display: block;
            color: #dcbc6a;
            font-size: 0.82rem;
            margin-bottom: 6px;
        }

        .request-meta-item strong {
            font-size: 1rem;
            color: #fff;
        }

    .request-link-box {
        margin-bottom: 14px;
        padding: 14px;
        border-radius: 16px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(212,175,55,0.08);
    }

        .request-link-box span {
            display: block;
            color: #dcbc6a;
            font-size: 0.82rem;
            margin-bottom: 6px;
        }

        .request-link-box a {
            color: #f0c95c;
            text-decoration: none;
            overflow-wrap: anywhere;
            word-break: break-all;
        }

        .request-link-box div {
            overflow-wrap: anywhere;
            word-break: break-word;
        }

            .request-link-box a:hover {
                text-decoration: underline;
            }

    .request-date {
        color: #dcbc6a;
        font-size: 0.9rem;
        margin-bottom: 16px;
    }

    .request-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

        .request-actions form {
            flex: 1;
        }

        .request-actions button {
            width: 100%;
            border: none;
            border-radius: 14px;
            padding: 12px 14px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s ease;
        }

    .btn-approve {
        color: #fef3d6;
        background: linear-gradient(135deg, #4b3a1d, #2c2214);
        border: 1px solid rgba(212,175,55,0.28);
    }

    .btn-reject {
        color: #fef3d6;
        background: linear-gradient(135deg, #4a1f1f, #2a1414);
        border: 1px solid rgba(220,120,120,0.2);
    }

    .btn-refresh {
        color: #fef3d6;
        background: linear-gradient(135deg, #334155, #1f2937);
        border: 1px solid rgba(148, 163, 184, 0.28);
        border-radius: 14px;
        padding: 12px 14px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .btn-delete {
        color: #fef3d6;
        background: linear-gradient(135deg, #5a1f1f, #2a1111);
        border: 1px solid rgba(248,113,113,0.28);
    }

    .request-actions button:hover {
        transform: translateY(-1px);
    }

    .admin-placeholder .placeholder-card {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 22px;
        border-radius: 20px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(212,175,55,0.08);
    }

    .placeholder-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 800;
        color: #f0c95c;
        background: rgba(212,175,55,0.08);
        border: 1px solid rgba(212,175,55,0.16);
    }

    .placeholder-card h3 {
        margin: 0 0 8px;
        font-size: 1.1rem;
        font-weight: 800;
        color: #fef3d6;
    }

    .placeholder-card p {
        margin: 0;
        color: #dcbc6a;
        line-height: 1.6;
    }

    .admin-pagination {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 22px;
    }

    .admin-pagination a {
        min-width: 42px;
        text-align: center;
