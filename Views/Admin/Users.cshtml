@model WebApplication1.Models.AdminUsersViewModel

@{
    var defaultBanUntil = DateTime.Now.AddDays(1).ToString("yyyy-MM-ddTHH:mm");
}

@{
    ViewData["Title"] = "Админка: пользователи";
}

<div class="admin-page">
    <div class="admin-container">
        <div class="admin-header">
            <div>
                <h1>Пользователи</h1>
                <p>Профили, XP за квесты, ежедневки и выполненные челленджи.</p>
            </div>
            <form method="post" asp-controller="Admin" asp-action="Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="admin-logout-btn">Выйти</button>
            </form>
        </div>

        <partial name="_AdminNav" />

        @if (TempData["AdminSuccess"] != null)
        {
            <div class="admin-flash admin-flash-success">@TempData["AdminSuccess"]</div>
        }
        @if (TempData["AdminError"] != null)
        {
            <div class="admin-flash admin-flash-error">@TempData["AdminError"]</div>
        }

        <div class="admin-stats">
            <div class="admin-stat-card"><span>Всего пользователей</span><strong>@Model.TotalUsers</strong></div>
        </div>

        <section class="admin-section">
            <div class="admin-section-head">
                <h2>Список пользователей</h2>
                <p>Статистика помогает видеть прогресс ежедневок и челленджей.</p>
            </div>

                <form method="post" asp-controller="Admin" asp-action="SyncAllUsers" onsubmit="return confirm('Запустить синхронизацию всех пользователей? Это может занять время.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-refresh">&#1057;&#1080;&#1085;&#1093;&#1088;&#1086;&#1085;&#1080;&#1079;&#1080;&#1088;&#1086;&#1074;&#1072;&#1090;&#1100; &#1074;&#1089;&#1077;&#1093;</button>
                </form>

            @if (!Model.Users.Any())
            {
                <div class="admin-empty">Пользователей пока нет.</div>
            }
            else
            {
                <div class="admin-grid">
                    @foreach (var user in Model.Users)
                    {
                        <div class="request-card">
                            <div class="request-image-wrap">
                                <img src="@user.AvatarUrl" alt="@user.SteamName" class="request-image" />
                                <div class="request-status @(user.IsBanned ? "rejected" : "approved")">#@user.Id</div>
                            </div>
                            <div class="request-body">
                                <h3>@user.SteamName</h3>
                                <div class="request-meta">
                                    <div class="request-meta-item"><span>Ачивок</span><strong>@user.TotalAchievements</strong></div>
                                    <div class="request-meta-item"><span>Quest XP</span><strong>@user.QuestExperience</strong></div>
                                    <div class="request-meta-item"><span>Ежедневок</span><strong>@user.CompletedDailyQuests</strong></div>
                                    <div class="request-meta-item"><span>Челленджей</span><strong>@user.CompletedChallenges</strong></div>
                                </div>
                                <div class="request-link-box"><span>Steam ID</span><div>@user.SteamId</div></div>
                                @if (user.IsBanned)
                                {
                                    <div class="request-link-box admin-ban-box">
                                        <span>Бан активен до @user.BannedUntil?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                        <div>@(string.IsNullOrWhiteSpace(user.BanReason) ? "Причина не указана." : user.BanReason)</div>
                                    </div>
                                }
                                <div class="request-date">
                                    Создан: @user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    @if (user.LastSync.HasValue)
                                    {
                                        <span> · sync: @user.LastSync.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                    }
                                </div>
                                <div class="request-actions">
                                    @if (user.IsBanned)
                                    {
                                        <form method="post" asp-controller="Admin" asp-action="UnbanUser" asp-route-usersPage="@Model.UsersPage">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn-approve">Разбанить</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn-reject"
                                                data-ban-open
                                                data-user-id="@user.Id"
                                                data-user-name="@user.SteamName">
                                            Бан
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.UsersTotalPages > 1)
                {
                    <div class="admin-pagination">
                        @for (var i = 1; i <= Model.UsersTotalPages; i++)
                        {
                            <a class="@(i == Model.UsersPage ? "active" : "")" asp-controller="Admin" asp-action="Users" asp-route-usersPage="@i">@i</a>
                        }
                    </div>
                }
            }
        </section>
    </div>
</div>

<div class="admin-modal-overlay" data-ban-modal hidden>
    <div class="admin-modal">
        <button type="button" class="admin-modal-close" data-ban-close aria-label="Закрыть">×</button>
        <h2>Забанить пользователя</h2>
        <p data-ban-user-name></p>

        <form method="post" asp-controller="Admin" asp-action="BanUser" asp-route-usersPage="@Model.UsersPage">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" data-ban-user-id />

            <label>
                <span>Бан до</span>
                <input type="datetime-local" name="bannedUntil" value="@defaultBanUntil" required />
            </label>

            <label>
                <span>Причина</span>
                <textarea name="reason" maxlength="500" rows="4" placeholder="Например: спам синхронизацией или нарушение правил"></textarea>
            </label>

            <button type="submit" class="btn-reject">Забанить</button>
        </form>
    </div>
</div>

<script>
    (() => {
        const modal = document.querySelector('[data-ban-modal]');
        if (!modal) {
            return;
        }

        const userIdInput = modal.querySelector('[data-ban-user-id]');
        const userName = modal.querySelector('[data-ban-user-name]');

        document.querySelectorAll('[data-ban-open]').forEach((button) => {
            button.addEventListener('click', () => {
                userIdInput.value = button.dataset.userId || '';
                userName.textContent = button.dataset.userName || '';
                modal.hidden = false;
            });
        });

        const close = () => {
            modal.hidden = true;
        };

        modal.querySelectorAll('[data-ban-close]').forEach((button) => button.addEventListener('click', close));
        modal.addEventListener('click', (event) => {
            if (event.target === modal) {
                close();
            }
        });
    })();
</script>

<partial name="_AdminStyles" />
